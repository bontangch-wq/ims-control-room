DATABASE_URL=postgresql://USER:PASSWORD@HOST/ims_control_room?sslmode=require
NEON_AUTH_BASE_URL=https://ep-snowy-voice-b3szthxr.neonauth.c-4.ap-southeast-1.aws.neon.tech/ims_control_room/auth
# Generate a cryptographically random secret of at least 32 characters. Never commit the real value.
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
COOKIE_DOMAIN=

# Neon Object Storage (private controlled-document bucket).
# Pull branch credentials into the deployment environment; never commit real credential values.
NEON_STORAGE_ENDPOINT=https://br-wispy-leaf-b3zq34zt.storage.c-4.ap-southeast-1.aws.neon.tech
NEON_STORAGE_BUCKET=ims-controlled-documents
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_NEON_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_NEON_STORAGE_SECRET_KEY
